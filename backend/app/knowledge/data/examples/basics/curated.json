  "id": "rules_check_block",
  "status": "verified",
  "title": "Check — and the three ways out",
  "concept": "check",
  "category": "basics",
  "difficulty": 1,
  "description": "White gives check with the bishop. Black must deal with it right away.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
