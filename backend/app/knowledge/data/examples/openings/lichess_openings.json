 {
  "id": "opening_caro_karpov",
  "status": "verified",
  "title": "Caro-Kann: the Karpov Variation",
  "concept": "caro_kann",
  "category": "openings",
  "subcategory": "Caro-Kann Defense: Karpov Variation",
  "difficulty": 3,
  "description": "Black plays ...Nd7 first, so the other knight can come to f6 without doubled pawns.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
  "moves": [
