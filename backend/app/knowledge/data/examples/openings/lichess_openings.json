  "title": "The Evans Gambit",
  "concept": "evans_gambit",
  "category": "openings",
  "subcategory": "Italian Game: Evans Gambit, Main Line",
  "difficulty": 3,
  "description": "White gives a pawn on b4 to gain time and build a quick centre with c3 and d4.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
  "moves": [
