  "title": "Italian Game: the slow Giuoco Pianissimo",
  "concept": "italian_game",
  "category": "openings",
  "subcategory": "Italian Game: Classical Variation, Giuoco Pianissimo",
  "difficulty": 2,
  "description": "The 'very quiet game': White plays d3 instead of d4, keeps the centre closed and develops calmly.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
