  "id": "opening_caro_classical",
  "status": "verified",
  "title": "Caro-Kann: the Classical Variation",
  "concept": "caro_kann",
  "category": "openings",
  "subcategory": "Caro-Kann Defense: Classical Variation",
  "difficulty": 3,
  "description": "Black takes on e4 and develops the bishop with tempo. White chases it with the knight and the h-pawn.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
  "moves": [
