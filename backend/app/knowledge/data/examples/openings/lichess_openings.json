 {
  "id": "opening_fried_liver",
  "status": "verified",
  "title": "The Fried Liver Attack",
  "concept": "fried_liver",
  "category": "openings",
  "subcategory": "Italian Game: Two Knights Defense, Fried Liver Attack",
  "difficulty": 3,
  "description": "White sacrifices a knight on f7 to drag Black's king into the centre.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
  "moves": [
   "e4",
   "e5",
   "Nf3",
   "Nc6",
   "Bc4",
   "Nf6",
   "Ng5",
   "d5",
