 {
  "id": "mistake_damiano_defense",
  "status": "verified",
  "title": "Weakening the king: the Damiano Defense",
  "concept": "king_safety_mistake",
  "category": "mistakes",
  "difficulty": 2,
  "description": "Black defends the e5 pawn with the f-pawn, weakening the king. After a knight sacrifice, Black's king gets hunted.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
  "moves": [
   "e4",
