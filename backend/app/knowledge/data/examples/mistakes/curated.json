 {
  "id": "mistake_pawn_shield_g5",
  "status": "verified",
  "title": "Weakening the king: mate on the e8-h5 diagonal",
  "concept": "king_safety_mistake",
  "category": "mistakes",
  "difficulty": 1,
  "description": "Black moves the f- and g-pawns in front of the king. The diagonal to e8 opens and the white queen mates at once.",
  "start_fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
  "moves": [
