 {
  "id": "endgame_rule_of_the_square",
  "status": "verified",
  "title": "The rule of the square",
  "concept": "passed_pawn",
  "concepts": [
   "promotion"
  ],
  "category": "endgames",
  "difficulty": 2,
  "description": "Can Black's king catch the passed pawn? Count it out with the 'square'.",
  "start_fen": "8/5k2/8/1P6/8/8/8/6K1 w - - 0 1",
  "moves": [
   "b6",
   "Ke6",
   "b7",
