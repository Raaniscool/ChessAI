 {
  "id": "endgame_kr_opposition_mate",
  "status": "verified",
  "title": "King and rook: take the opposition, then mate",
  "concept": "rook_mate",
  "concepts": [
   "opposition"
  ],
  "category": "endgames",
  "difficulty": 2,
  "description": "The rook can only mate when the kings face each other. White's king steps into the opposition first.",
  "start_fen": "3k4/8/4K3/8/8/8/8/7R w - - 0 1",
  "moves": [
   "Kd6",
   "Ke8",
   "Rf1",
   "Kd8",
   "Rf8#"
  ],
  "final_fen": "3k1R2/8/3K4/8/8/8/8/8 b - - 5 3",
  "key_move": "1.Kd6",
  "prompt": "White to move. Get your king into the right place before using the rook.",
  "hints": [
   "The rook mates on the back rank only when your king guards the squares in front of the enemy king.",
   "Put your king directly opposite Black's king."
  ],
  "notes": {
   "1.Kd6": "The kings now face each other on d6 and d8, and it's Black's move: White has the opposition.",
   "2.Rf1": "A waiting move. The rook will come to the eighth rank next.",
   "3.Rf8#": "Checkmate: the rook checks along the eighth rank, and the white king guards c7, d7 and e7."
  },
  "explanation": "With king and rook you mate on the edge. The rook gives check along the edge, and your king must stand opposite the enemy king to cover the squares in front of it. That is why the kings meet in opposition first.",
  "tags": [
   "endgame",
   "checkmate",
   "rook",
   "technique",
   "opposition"
  ],
  "presentation_modes": [
   "demonstration",
   "interactive",
   "hint",
   "practice",
   "deep_dive"
  ],
