# Copy to .env (same folder) and edit. .env is git-ignored and read at startup.
# Variables set in your shell override these.

# Optional local Qwen through Ollama. First install/verify a model with `ollama list`.
# Leave unset (or blank) until the exact model is installed and the server is reachable.
# QWEN_MODEL=qwen3:1.7b                    # smaller candidate; quality/latency must be verified locally
# QWEN_MODEL=qwen3:4b-instruct             # larger instruct candidate
# QWEN_BASE_URL=http://localhost:11434/v1  # LM Studio: http://localhost:1234/v1
# QWEN_TIMEOUT=120
# QWEN_MAX_TOKENS=300
# QWEN_PLANNER=auto                           # auto | always | never
# QWEN_THINKING=auto                          # auto | on | off
# Decision Puzzles use one short assessment call; no model is forced when QWEN_MODEL is unset.
# DECISION_ASSESSMENT_TIMEOUT=4               # read/inference timeout; connection phase is capped at 1 second
# DECISION_ASSESSMENT_MAX_TOKENS=140

# Engine
# ENGINE_DEPTH=14
# DECISION_ENGINE_DEPTH=10                    # bounded Stockfish check used only by Decision Puzzles
# DECISION_ENGINE_TIMEOUT=6                   # total search budget (split across before/after)
# Game analysis (Chess.com games): quick pass depth; mistakes are re-checked at ENGINE_DEPTH.
# GAME_ANALYSIS_DEPTH=12
